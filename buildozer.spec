[app]
title = Ojeda Station
package.name = ojedastation
package.domain = org.ojeda
source.dir = .
source.include_exts = py,png,jpg,kv,atlas
version = 10.5
requirements = python3,kivy
orientation = portrait
fullscreen = 1
permissions = INTERNET
android.api = 33
android.minapi = 21
android.archs = arm64-v8a, armeabi-v7a

[buildozer]
log_level = 2
warn_on_root = 1
